<Window x:Class="ClaudeWorkflowSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Workbench" Width="940" Height="640" MinWidth="940" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="app.ico"
        ResizeMode="CanResize" WindowStyle="None" StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" Background="{StaticResource Base}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Mantle}">
            <DockPanel Margin="26,22,22,22">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,36">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Accent}">
                        <TextBlock Text="&gt;_" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="15"
                                   Foreground="{StaticResource Crust}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Agent Workbench" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="ModeLabel" Text="Setup" Foreground="{StaticResource Subtext}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="PackageInfo" DockPanel.Dock="Bottom" FontSize="11" Foreground="{StaticResource Overlay0}" LineHeight="17"/>
                <StackPanel x:Name="StepList"/>
                <StackPanel x:Name="NavList" Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Chrome}" Click="Minimize_Click" ToolTip="Minimize">
                    <Path Data="M0,0 L10,0" Stroke="{StaticResource Subtext}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource Chrome}" Click="Maximize_Click" ToolTip="Maximize or restore (double-click the title bar)">
                    <Path x:Name="MaximizeIcon" Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="{StaticResource Subtext}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource Chrome}" Click="Close_Click">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Subtext}" StrokeThickness="1"/>
                </Button>
            </StackPanel>

            <!-- Overview (installed app) -->
            <Grid x:Name="PageOverview" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Your configuration" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="OverviewLead" Style="{StaticResource Lead}" Margin="0,0,0,8"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel x:Name="OverviewPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- MCP servers (installed app) -->
            <Grid x:Name="PageMcp" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="MCP servers" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="McpLead" Style="{StaticResource Lead}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="McpScope" Margin="0,0,0,4"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel>
                        <StackPanel x:Name="ManageMcpList"/>
                        <Button Content="+ Add server" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Padding="14,7" Click="ManageAddMcp_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Agents (installed app) -->
            <Grid x:Name="PageAgents" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Agents" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="AgentsLead" Style="{StaticResource Lead}" Margin="0,0,0,8"/>
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AgentSearch" TextChanged="AgentSearch_TextChanged"/>
                        <TextBlock x:Name="AgentSearchHint" Text="Search agents by name or description" IsHitTestVisible="False" Margin="11,8,0,0"
                                   FontSize="13" Foreground="{StaticResource Overlay0}"/>
                        <Button Grid.Column="1" Content="+ New agent" Style="{StaticResource Secondary}" Padding="14,7" Margin="10,0,0,0" Click="NewAgent_Click"/>
                    </Grid>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel x:Name="AgentList"/>
                </ScrollViewer>
            </Grid>

            <!-- Agent editor (installed app) -->
            <Grid x:Name="PageAgentEdit" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <WrapPanel x:Name="AgentEditCrumb"/>
                    <TextBlock x:Name="AgentEditTitle" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="AgentEditLead" Style="{StaticResource Lead}" Margin="0,0,0,8"/>
                </StackPanel>
                <ScrollViewer x:Name="AgentEditScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel x:Name="AgentEditPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- Projects (installed app) -->
            <Grid x:Name="PageProjects" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <WrapPanel x:Name="ProjectsCrumb" Visibility="Collapsed"/>
                    <TextBlock x:Name="ProjectsTitle" Text="Projects" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="ProjectsLead" Style="{StaticResource Lead}" Margin="0,0,0,8"/>
                </StackPanel>
                <ScrollViewer x:Name="ProjectsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel x:Name="ProjectsPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- Settings (installed app) -->
            <Grid x:Name="PageConfig" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="ConfigLead" Style="{StaticResource Lead}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="ConfigScope" Margin="0,0,0,4"/>
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConfigSearch" TextChanged="ConfigSearch_TextChanged"/>
                        <TextBlock x:Name="ConfigSearchHint" Text="Search settings" IsHitTestVisible="False" Margin="11,8,0,0"
                                   FontSize="13" Foreground="{StaticResource Overlay0}"/>
                        <CheckBox x:Name="ConfigOnlySet" Grid.Column="1" Style="{StaticResource ChipToggle}" Content="Only set values"
                                  Margin="10,0,0,0" VerticalAlignment="Center" Checked="ConfigOnlySet_Click" Unchecked="ConfigOnlySet_Click"/>
                    </Grid>
                    <WrapPanel x:Name="ConfigJump" Margin="0,0,0,6"/>
                </StackPanel>
                <ScrollViewer x:Name="ConfigScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel x:Name="ConfigPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- 0 Welcome -->
            <Grid x:Name="PageWelcome" Grid.Row="1" Margin="44,10,44,0">
                <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Your coding setup, on this PC." Style="{StaticResource H1}" FontSize="30"/>
                    <TextBlock Style="{StaticResource Lead}">
                        Sets up Claude Code, Codex or OpenCode with everything that belongs to a working setup:
                        the tmux layout, an Obsidian vault as long-term memory, agents and your MCP servers.
                        First you pick the coding tools, then the options that fit them.
                    </TextBlock>
                    <Border Background="{StaticResource Surface0}" CornerRadius="10" Padding="16,14">
                        <StackPanel x:Name="WelcomeFacts"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 1 Coding tools -->
            <Grid x:Name="PageTools" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Which coding tools do you want to use?" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Lead}" Margin="0,0,0,10"
                               Text="Pick one or more. A tool already on this PC is not installed again, it only gets set up. The next step shows the options that fit your choice."/>
                    <Border Background="{StaticResource Mantle}" CornerRadius="8" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock x:Name="WslStatus" FontSize="12.5" Foreground="{StaticResource Subtext}" Text="Checking this PC …"/>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel x:Name="ToolCards"/>
                </ScrollViewer>
            </Grid>

            <!-- 2 Options -->
            <Grid x:Name="PageComponents" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Options" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="ComponentsLead" Style="{StaticResource Lead}" Margin="0,0,0,10"/>
                </StackPanel>
                <ScrollViewer x:Name="ComponentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel x:Name="ComponentGroups"/>
                </ScrollViewer>
            </Grid>

            <!-- 3 Settings -->
            <Grid x:Name="PageSettings" Grid.Row="1" Margin="44,10,30,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Lead}" Margin="0,0,0,4" Text="Only what your selection needs."/>
                </StackPanel>
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,12">
                    <StackPanel>
                        <StackPanel x:Name="DistroSection">
                            <TextBlock Text="WSL DISTRIBUTION" Style="{StaticResource GroupLabel}"/>
                            <WrapPanel x:Name="DistroChips"/>
                            <TextBlock x:Name="DistroNote" FontSize="12" Foreground="{StaticResource Subtext}"/>
                        </StackPanel>

                        <StackPanel x:Name="VaultSection">
                            <TextBlock Text="OBSIDIAN VAULT" Style="{StaticResource GroupLabel}"/>
                            <WrapPanel x:Name="VaultSourceChips" Margin="0,0,0,4"/>
                            <TextBlock x:Name="VaultSourceNote" FontSize="12" Foreground="{StaticResource Subtext}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VaultPath" TextChanged="VaultPath_TextChanged"/>
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource Secondary}" Margin="8,0,0,0" Padding="14,7" Click="BrowseVault_Click"/>
                            </Grid>
                            <TextBlock x:Name="VaultNote" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock x:Name="VaultAgents" FontSize="12" Foreground="{StaticResource Subtext}" Margin="0,4,0,0"/>
                            <CheckBox x:Name="WorkflowToggle" Style="{StaticResource Card}" Margin="0,12,0,0" Click="WorkflowToggle_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="GitSection">
                            <TextBlock Text="GIT IDENTITY" Style="{StaticResource GroupLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GitName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GitEmail"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="McpSection">
                            <TextBlock Text="MCP SERVERS" Style="{StaticResource GroupLabel}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Subtext}" Margin="0,0,0,10"
                                       x:Name="McpSetupNote"/>
                            <StackPanel x:Name="McpFields"/>
                            <Button Content="+ Add server" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Padding="14,7" Click="AddMcp_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3 WSL -->
            <Grid x:Name="PageWsl" Grid.Row="1" Margin="44,10,44,0" Visibility="Collapsed">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock x:Name="WslTitle" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="WslText" Style="{StaticResource Lead}"/>
                    <StackPanel x:Name="WslUserForm" Visibility="Collapsed" Margin="0,0,0,18">
                        <TextBlock Text="Linux user name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="LinuxUser" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Password (for sudo)" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="LinuxPassword"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Repeat password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="LinuxPassword2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="WslAction" Style="{StaticResource Primary}" Click="WslAction_Click"/>
                        <TextBlock x:Name="WslBusy" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="WslLog" Margin="0,18,0,0" Height="150" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- 4 Install -->
            <Grid x:Name="PageInstall" Grid.Row="1" Margin="44,10,44,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Installing" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="CurrentStep" Style="{StaticResource Lead}" Margin="0,0,0,16" Text="Preparing"/>
                    <ProgressBar x:Name="Progress" Maximum="1"/>
                    <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource Subtext}" Margin="0,8,0,14"/>
                </StackPanel>
                <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,0,0,10" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden"/>
            </Grid>

            <!-- 5 Done -->
            <Grid x:Name="PageDone" Grid.Row="1" Margin="44,10,44,0" Visibility="Collapsed">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border x:Name="DoneBadge" Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <Path x:Name="DoneIcon" Stroke="{StaticResource Crust}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="DoneText" Style="{StaticResource Lead}"/>
                    <StackPanel x:Name="DoneActions"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Surface0}" BorderThickness="0,1,0,0" Padding="44,16,44,18">
                <DockPanel>
                    <TextBlock x:Name="FooterNote" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Red}" MaxWidth="360"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Content="Back" Style="{StaticResource Secondary}" Margin="0,0,10,0" Click="Back_Click"/>
                        <Button x:Name="NextButton" Content="Next" Style="{StaticResource Primary}" Click="Next_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
