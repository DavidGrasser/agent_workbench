{
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/git_write_guard.py",
            "if": "Bash(git *)",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/git_write_guard.py",
            "if": "Bash(gh *)",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/graph_pulse.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/vault-link.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
